{
  "datasets": [
    "llama-128-ip",
    "yahoo-minilm-384-normalized",
    "coco-nomic-768-normalized"
  ],
  "seed": 1,
  "n_fit": 20000,
  "n_reconstruct": 1000,
  "n_eval": 1000,
  "k": [1, 10, 100],
  "temp": [0.05, 0.2, 1.0],
  "methods": [
    { "name": "spike_vq", "b": [2, 3, 4, 6], "ratio": [0.05] },
    { "name": "specbit", "b": [2, 3, 4, 6] },
    { "name": "turbobitnet", "rotation": "hadamard" },
    { "name": "e8quant", "b": [2, 3, 4, 6], "residual": [false, true] },
    { "name": "anchorquant", "k": [16, 64] },
    { "name": "spectralquant", "b": [2, 3, 4, 6] },
    { "name": "bitnet", "rotation": "hadamard" },
    { "name": "turboquant_prod", "b": [2, 3, 4, 6] },
    { "name": "eden_prod", "b": [2, 3, 4, 6] },
    { "name": "scalar", "b": [2, 3, 4, 6] }
  ],
  "metrics": ["recall", "mse_score", "mse_recon", "bias_score", "bias_recon", "sos", "exp_sos", "kl", "tv"]
}
