{
  "datasets": [
    "msmarco-colbert-128-normalized",
    "imagenet-clip-512-normalized",
    "coco-nomic-768-normalized"
  ],
  "seed": 1,
  "n_fit": 20000,
  "n_reconstruct": 1000,
  "n_eval": 1000,
  "k": [
    1,
    10,
    50,
    100
  ],
  "temp": [
    0.05,
    0.2,
    1.0
  ],
  "methods": [
    {
      "name": "hierarchical_shell",
      "b": [1, 2, 4]
    },
    {
      "name": "hierarchical_shell",
      "b": 4,
      "truncate_to": [1, 2]
    },
    {
      "name": "qjl",
      "b": 1
    },
    {
      "name": "rabitq"
    },
    {
      "name": "simhash",
      "b": 1
    },
    {
      "name": "scalar",
      "b": 1
    },
    {
      "name": "eden_prod",
      "b": [2, 4]
    }
  ],
  "metrics": [
    "recall",
    "mse_score",
    "mse_recon",
    "bias_score",
    "bias_recon",
    "sos",
    "exp_sos",
    "kl",
    "tv"
  ]
}
