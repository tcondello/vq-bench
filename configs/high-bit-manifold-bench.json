{
  "datasets": [
    "coco-nomic-768",
    "msmarco-qwen-1024-normalized"
  ],
  "seed": 1,
  "n_fit": 20000,
  "n_reconstruct": 1000,
  "n_eval": 1000,
  "k": [1, 10, 100],
  "temp": [0.05, 0.2, 1.0],
  "methods": [
    { "name": "scalar", "b": [3, 4] },
    { "name": "eden_prod", "b": [3, 4] },
    { "name": "spike_eden", "b": [3, 4], "ratio": [0.05] },
    { "name": "manifold_shell", "b": [4, 6, 8], "ratio": [0.50] },
    { "name": "manifold_leech", "b": [4, 6, 8], "ratio": [0.50] },
    { "name": "spike_manifold_shell", "b": [4, 6, 8], "spike_ratio": [0.05], "spectral_ratio": [0.50] },
    { "name": "spike_manifold_leech", "b": [4, 6, 8], "spike_ratio": [0.05], "spectral_ratio": [0.50] }
  ],
  "metrics": ["recall", "mse_score", "mse_recon", "bias_score", "bias_recon", "sos", "exp_sos", "kl", "tv"]
}
